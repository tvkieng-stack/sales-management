<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.salesmanagement.controller.CustomerController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <VBox spacing="10">
            <Label text="QUẢN LÝ KHÁCH HÀNG" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <GridPane hgap="8" vgap="8">
                <TextField fx:id="nameField" promptText="Tên khách hàng" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="phoneField" promptText="Điện thoại" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <TextField fx:id="emailField" promptText="Email" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextField fx:id="addressField" promptText="Địa chỉ" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            </GridPane>
            <HBox spacing="8">
                <Button text="Thêm mới" onAction="#handleAdd"/>
                <Button text="Cập nhật" onAction="#handleUpdate"/>
                <Button text="Làm mới" onAction="#handleRefresh"/>
            </HBox>
            <Label fx:id="messageLabel" style="-fx-text-fill: red;"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="customerTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nameColumn" text="Tên khách hàng" prefWidth="160"/>
                <TableColumn fx:id="phoneColumn" text="Điện thoại" prefWidth="110"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
                <TableColumn fx:id="addressColumn" text="Địa chỉ" prefWidth="160"/>
                <TableColumn fx:id="pointsColumn" text="Điểm tích lũy" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
</BorderPane>